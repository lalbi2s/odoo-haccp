<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_bs_haccp" model="res.groups.privilege">
        <field name="name">HACCP</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_bs_haccp_user" model="res.groups">
        <field name="name">Employee</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bs_haccp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bs_haccp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bs_haccp"/>
        <field name="implied_ids" eval="[(4, ref('group_bs_haccp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>