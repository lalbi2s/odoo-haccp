<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bs_haccp_equipment_view_list" model="ir.ui.view">
        <field name="name">bs.haccp.equipment.view.list</field>
        <field name="model">bs.haccp.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="location_id"/>
                <field name="temp_min"/>
                <field name="temp_max"/>
                <field name="last_reading_date"/>
                <field name="check_state" widget="badge"
                       decoration-success="check_state == 'up_to_date'"
                       decoration-warning="check_state == 'due_soon'"
                       decoration-danger="check_state == 'overdue'"/>
            </list>
        </field>
    </record>

    <record id="bs_haccp_equipment_view_kanban" model="ir.ui.view">
        <field name="name">bs.haccp.equipment.view.kanban</field>
        <field name="model">bs.haccp.equipment</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="check_state" widget="badge" class="ms-auto"
                                   decoration-success="check_state == 'up_to_date'"
                                   decoration-warning="check_state == 'due_soon'"
                                   decoration-danger="check_state == 'overdue'"/>
                        </div>
                        <div class="text-muted">
                            <field name="equipment_type"/>
                            <t t-if="record.location_id.raw_value">
                                - <field name="location_id"/>
                            </t>
                        </div>
                        <div>
                            <field name="temp_min"/> °C to <field name="temp_max"/> °C
                        </div>
                        <footer>
                            <span t-if="record.last_reading_date.raw_value">
                                Last reading: <field name="last_reading_date"/>
                            </span>
                            <span t-else="" class="text-muted">No reading yet</span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bs_haccp_equipment_view_form" model="ir.ui.view">
        <field name="name">bs.haccp.equipment.view.form</field>
        <field name="model">bs.haccp.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="equipment_type"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="temp_min"/>
                            <field name="temp_max"/>
                            <field name="check_interval_hours"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="reference"/>
                            <field name="serial_number"/>
                        </group>
                        <group>
                            <field name="last_reading_date"/>
                            <field name="check_state" widget="badge"
                                   decoration-success="check_state == 'up_to_date'"
                                   decoration-warning="check_state == 'due_soon'"
                                   decoration-danger="check_state == 'overdue'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readings" name="readings">
                            <field name="reading_ids">
                                <list decoration-danger="not is_compliant">
                                    <field name="reading_date"/>
                                    <field name="temperature"/>
                                    <field name="is_compliant"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bs_haccp_equipment_view_search" model="ir.ui.view">
        <field name="name">bs.haccp.equipment.view.search</field>
        <field name="model">bs.haccp.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location_id"/>
                <filter name="fridge" string="Fridges"
                        domain="[('equipment_type', '=', 'fridge')]"/>
                <filter name="freezer" string="Freezers"
                        domain="[('equipment_type', '=', 'freezer')]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_location" string="Location"
                            context="{'group_by': 'location_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'equipment_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bs_haccp_equipment_action" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">bs.haccp.equipment</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>