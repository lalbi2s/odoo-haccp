<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bs_haccp_reading_view_list" model="ir.ui.view">
        <field name="name">bs.haccp.reading.view.list</field>
        <field name="model">bs.haccp.reading</field>
        <field name="arch" type="xml">
            <list>
                <field name="reading_date"/>
                <field name="equipment_id"/>
                <field name="temperature"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="bs_haccp_reading_view_form" model="ir.ui.view">
        <field name="name">bs.haccp.reading.view.form</field>
        <field name="model">bs.haccp.reading</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="temperature"/>
                        </group>
                        <group>
                            <field name="reading_date"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="corrective_action"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bs_haccp_reading_view_search" model="ir.ui.view">
        <field name="name">bs.haccp.reading.view.search</field>
        <field name="model">bs.haccp.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <group>
                    <filter name="group_equipment" string="Equipment"
                            context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bs_haccp_reading_action" model="ir.actions.act_window">
        <field name="name">Readings</field>
        <field name="res_model">bs.haccp.reading</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>